PORT=3001
PUBLIC_URL=http://localhost:5173
DATA_MODE=demo
# Production: postgres://user:pass@host:5432/github_pulse
# Leave unset to use the embedded PGlite database in ./data/pglite
DATABASE_URL=
# Optional override for the PGlite data directory (tests use a temp dir)
PGLITE_DIR=
# Set DATA_MODE=live, then provide a GitHub token for higher rate limits.
GITHUB_TOKEN=
# Optional Website-page enrichment. It can also be stored from Site administration.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
# Set to 1 to write structured API latency, DB time, response size, and status logs.
PERF_LOG=0
# Outside demo mode, configure Resend with a verified sender address, or use SMTP.
# Demo emails appear in the server log and /api/demo-outbox.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Trend Top <pulse@example.com>
# Encryption key for unsubscribe links (and AUTH_SECRET fallback). No longer a sign-in token.
ADMIN_TOKEN=
# Comma-separated account emails that may open /en/admin. Defaults to zhangyuge.ghs@gmail.com.
ADMIN_EMAILS=
# Long random secret for hashing registration and password-reset email codes.
# ADMIN_TOKEN is used as a fallback when this is unset.
AUTH_SECRET=

# Optional billing bootstrap values. After the first deployment, these can be
# entered and changed at /en/admin (or /zh/admin) and are encrypted in the DB.
CREEM_MODE=test
CREEM_API_BASE_URL=https://test-api.creem.io
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
# Display prices in major units with decimals (9.99), one set per site language; Creem charges the product price.
CREEM_PRICE_PRO_MONTHLY=
CREEM_PRICE_PRO_YEARLY=
CREEM_CURRENCY=USD
CREEM_PRICE_PRO_MONTHLY_ZH=
CREEM_PRICE_PRO_YEARLY_ZH=
CREEM_CURRENCY_ZH=CNY
BILLING_GRACE_DAYS=3
CONTACT_EMAIL=
SOCIAL_X_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_TELEGRAM_URL=

# Docker Compose interpolates this for the dedicated Postgres (host 127.0.0.1:5433).
# Use a long alphanumeric value; avoid @ : / in the password.
POSTGRES_PASSWORD=change-this-to-a-long-random-password
