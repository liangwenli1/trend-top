# ============================================================
#  唯一必须改的一行：数据库密码
#  其余全部可以留空 —— AI 密钥、管理口令、域名、定时时间、
#  亚马逊 tag 等都在管理后台（/admin）里配置。
# ============================================================

POSTGRES_PASSWORD=change-me-please


# ------------------------------------------------------------
# 以下都是可选项，留空即用默认值
# ------------------------------------------------------------

# 想让 AI 密钥走环境变量而不是后台，就填这里（填了则后台改不动，以此为准）
LLMHUB_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# 图库密钥（可选）。任填一个，文章题图就从内置生成封面换成真实照片；
# 都不填也能正常跑。也可以登录后台在「模型与密钥」里填，不必改这里。
# AI 生图密钥（推荐）。配好 config/site.yaml 里的 images.generate 后启用；
# 相关度和独特性都优于图库，见 README「五、配图」。
IMAGE_API_KEY=

PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# 后台登录账号密码。/admin 是公网可达的，部署前请务必改掉 ADMIN_PASSWORD。
# 留空则回落到内置默认口令（见 README），仅供本地试跑，不要用于公网。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 管理 API 令牌：留空 = 自动生成。前端登录后自动拿，一般不用手填。
ADMIN_TOKEN=

# 数据库用户名与库名（除非要接已有数据库，否则别动）
POSTGRES_USER=station
POSTGRES_DB=station

# 定时表达式兜底值（后台「设置 → 发布策略」里改的优先）
SCHEDULER_CRON=0 7,12,18 * * *

# 向量维度：仅在开启语义查重时需要，必须与 embedding 模型一致
EMBED_DIM=1536

# 前台页面缓存秒数
REVALIDATE_SECONDS=300

# 服务器直连海外则留空；需要走代理才填
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,backend,frontend

LOG_LEVEL=INFO
