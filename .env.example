PORT=3001
PUBLIC_URL=http://localhost:5173
DATA_MODE=demo
# Production: postgres://user:pass@host:5432/github_pulse
# Leave unset to use the embedded PGlite database in ./data/pglite
DATABASE_URL=
# Optional override for the PGlite data directory (tests use a temp dir)
PGLITE_DIR=
# Set DATA_MODE=live, then provide a GitHub token for higher rate limits.
GITHUB_TOKEN=
# Outside demo mode, configure Resend with a verified sender address, or use SMTP.
# Demo emails appear in the server log and /api/demo-outbox.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Trend Top <pulse@example.com>
# Required in production for /api/admin and manual job endpoints.
ADMIN_TOKEN=
# Long random secret for hashing registration and password-reset email codes.
# ADMIN_TOKEN is used as a fallback when this is unset.
AUTH_SECRET=

# Docker Compose interpolates this for the dedicated Postgres (host 127.0.0.1:5433).
# Use a long alphanumeric value; avoid @ : / in the password.
POSTGRES_PASSWORD=change-this-to-a-long-random-password
